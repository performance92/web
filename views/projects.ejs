<%- include('partials/head') %>
<%- include('partials/topbar') %>
<%- include('partials/navbar') %>

<!-- Sayfa Başlığı (Banner) -->
<section class="relative bg-dark-900 text-white py-20 overflow-hidden">
  <div class="absolute inset-0 z-0">
    <img src="https://images.unsplash.com/photo-1541888946425-d0fbb186156f?q=80&w=2070&auto=format&fit=crop" alt="Projelerimiz" class="w-full h-full object-cover filter brightness-40">
    <div class="absolute inset-0 bg-gradient-to-t from-dark-900 via-dark-900/60 to-transparent"></div>
  </div>
  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-4">
    <div class="inline-flex items-center space-x-2 text-brand-400 font-extrabold text-xs tracking-wider uppercase">
      <a href="/" class="hover:text-white transition-colors">Anasayfa</a>
      <span class="text-slate-600">/</span>
      <span>Projelerimiz</span>
    </div>
    <h1 class="text-4xl sm:text-5xl font-extrabold text-white tracking-tight">
      Tamamlanan & Devam Eden Projeler
    </h1>
    <p class="text-slate-300 text-base max-w-2xl mx-auto">
      Yüksek mühendislik hassasiyeti ve modern mimariyle hayat bulan prestijli yapılarımız.
    </p>
  </div>
</section>

<!-- Projeler Listesi -->
<section class="py-16 bg-slate-50 min-h-screen">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Filtre Sekmeleri -->
    <div class="flex justify-center mb-12">
      <div class="inline-flex flex-wrap gap-2 bg-white p-2 rounded-2xl shadow-sm border border-slate-200">
        <a href="/projeler?kategori=all" class="px-5 py-2.5 rounded-xl text-xs font-bold transition-all <%= !activeCategory || activeCategory === 'all' ? 'bg-dark-900 text-white shadow-md' : 'text-slate-600 hover:bg-slate-100' %>">
          Tüm Projeler (<%= allProjects.length %>)
        </a>
        <a href="/projeler?kategori=Konut" class="px-5 py-2.5 rounded-xl text-xs font-bold transition-all <%= activeCategory && activeCategory.toLowerCase() === 'konut' ? 'bg-dark-900 text-white shadow-md' : 'text-slate-600 hover:bg-slate-100' %>">
          Konut & Rezidans
        </a>
        <a href="/projeler?kategori=Ticari" class="px-5 py-2.5 rounded-xl text-xs font-bold transition-all <%= activeCategory && activeCategory.toLowerCase() === 'ticari' ? 'bg-dark-900 text-white shadow-md' : 'text-slate-600 hover:bg-slate-100' %>">
          Ticari Plazalar
        </a>
        <a href="/projeler?kategori=Endüstriyel" class="px-5 py-2.5 rounded-xl text-xs font-bold transition-all <%= activeCategory && activeCategory.toLowerCase() === 'endüstriyel' ? 'bg-dark-900 text-white shadow-md' : 'text-slate-600 hover:bg-slate-100' %>">
          Endüstriyel & Lojistik
        </a>
      </div>
    </div>

    <!-- Projeler Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      <% if (projects && projects.length > 0) { %>
        <% projects.forEach(project => { %>
          <div class="group bg-white rounded-2xl overflow-hidden border border-slate-200/80 shadow-sm hover:shadow-2xl transition-all duration-300 flex flex-col">
            <div class="relative h-64 overflow-hidden">
              <img src="<%= project.image %>" alt="<%= project.title %>" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110">
              
              <div class="absolute top-4 left-4 flex flex-wrap gap-2">
                <span class="px-3 py-1 rounded-full text-[11px] font-extrabold uppercase tracking-wider <%= project.status === 'Tamamlandı' ? 'bg-emerald-500 text-white' : 'bg-brand-500 text-dark-900' %> shadow-md">
                  <%= project.status %>
                </span>
                <span class="px-3 py-1 rounded-full text-[11px] font-bold bg-dark-900/80 backdrop-blur-md text-white shadow-md">
                  <%= project.category %>
                </span>
              </div>

              <% if (project.images && project.images.length > 1) { %>
                <div class="absolute top-4 right-4 z-10">
                  <span class="px-2.5 py-1 rounded-full text-[11px] font-bold bg-dark-900/80 backdrop-blur-md text-white shadow-md flex items-center space-x-1.5">
                    <i class="fa-solid fa-images text-brand-400"></i>
                    <span><%= project.images.length %></span>
                  </span>
                </div>
              <% } %>

              <div class="absolute bottom-4 left-4 right-4 flex justify-between items-center text-white text-xs font-medium z-10">
                <span class="flex items-center space-x-1.5 drop-shadow">
                  <i class="fa-solid fa-location-dot text-brand-400"></i>
                  <span><%= project.location %></span>
                </span>
                <span class="flex items-center space-x-1.5 drop-shadow">
                  <i class="fa-regular fa-calendar text-brand-400"></i>
                  <span><%= project.year %></span>
                </span>
              </div>
              <div class="absolute inset-0 bg-gradient-to-t from-dark-900/80 via-transparent to-transparent"></div>
            </div>

            <div class="p-6 flex-1 flex flex-col justify-between space-y-4">
              <div>
                <h3 class="text-xl font-bold text-dark-900 group-hover:text-brand-600 transition-colors">
                  <a href="/proje/<%= project.id %>"><%= project.title %></a>
                </h3>
                <p class="text-sm text-slate-600 mt-2 line-clamp-2">
                  <%= project.description %>
                </p>
              </div>
              
              <div class="pt-4 border-t border-slate-100 flex items-center justify-between">
                <a href="/proje/<%= project.id %>" class="text-xs font-bold text-dark-900 hover:text-brand-600 transition-colors flex items-center space-x-1">
                  <span>Proje Detayı</span>
                  <i class="fa-solid fa-arrow-right text-xs"></i>
                </a>
                <a href="/iletisim" class="text-xs font-semibold text-brand-600 hover:text-brand-700">
                  Teklif Al
                </a>
              </div>
            </div>
          </div>
        <% }) %>
      <% } else { %>
        <div class="col-span-3 text-center py-20 bg-white rounded-2xl border border-slate-200">
          <i class="fa-regular fa-folder-open text-5xl text-slate-300 mb-4"></i>
          <h3 class="text-lg font-bold text-slate-700">Bu kategoride henüz proje bulunmuyor.</h3>
          <p class="text-sm text-slate-500 mt-1">Lütfen diğer kategorileri inceleyin veya anasayfaya dönün.</p>
          <a href="/projeler" class="inline-block mt-4 text-brand-600 font-bold text-sm hover:underline">Tüm Projeleri Göster</a>
        </div>
      <% } %>
    </div>

  </div>
</section>

<%- include('partials/footer') %>

