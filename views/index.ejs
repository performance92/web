<%- include('partials/head') %>
<%- include('partials/topbar') %>
<%- include('partials/navbar') %>

<!-- Başarı Bildirimi (Form gönderildiyse) -->
<% if (typeof successMsg !== 'undefined' && successMsg) { %>
  <div class="bg-emerald-600 text-white px-4 py-3 text-center text-sm font-semibold shadow-md flex items-center justify-center space-x-2">
    <i class="fa-solid fa-circle-check text-lg"></i>
    <span><%= successMsg %></span>
  </div>
<% } %>

<!-- ================= HERO SLIDER BÖLÜMÜ ================= -->
<section id="heroSliderSection" class="relative bg-dark-900 text-white min-h-[640px] lg:min-h-[720px] flex items-center overflow-hidden group">
  
  <!-- Slaytlar Konteyneri -->
  <div id="heroSliderContainer" class="absolute inset-0 z-0">
    <% const activeSlides = (typeof sliders !== 'undefined' && sliders && sliders.length > 0) ? sliders : [
      {
        id: '1',
        badge: settings.hero.badge,
        title: settings.hero.title,
        subtitle: settings.hero.subtitle,
        btnPrimaryText: settings.hero.btnPrimaryText,
        btnPrimaryLink: settings.hero.btnPrimaryLink,
        btnSecondaryText: settings.hero.btnSecondaryText,
        btnSecondaryLink: settings.hero.btnSecondaryLink,
        bgImage: settings.hero.bgImage
      }
    ]; %>

    <% activeSlides.forEach((slide, index) => { %>
      <div class="hero-slide absolute inset-0 transition-opacity duration-1000 ease-in-out <%= index === 0 ? 'opacity-100 z-10' : 'opacity-0 z-0 pointer-events-none' %>" data-slide-index="<%= index %>">
        <!-- Arka Plan Görseli & Gradient Katmanlar -->
        <img src="<%= slide.bgImage %>" alt="<%= slide.title %>" class="w-full h-full object-cover object-center transform scale-105 filter brightness-50 contrast-110">
        <div class="absolute inset-0 bg-gradient-to-r from-dark-900/95 via-dark-900/80 to-transparent"></div>
        <div class="absolute inset-0 bg-gradient-to-t from-dark-900 via-transparent to-transparent"></div>

        <!-- Slayt İçerik Alanı -->
        <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-full flex items-center py-20 lg:py-28">
          <div class="max-w-3xl space-y-6">
            
            <!-- Rozet / Badge -->
            <div class="inline-flex items-center space-x-2.5 px-4 py-1.5 rounded-full bg-brand-500/20 border border-brand-500/40 text-brand-400 text-xs sm:text-sm font-bold tracking-wide uppercase backdrop-blur-md">
              <i class="fa-solid fa-medal text-brand-400"></i>
              <span><%= slide.badge %></span>
            </div>

            <!-- Ana Başlık -->
            <h1 class="text-3xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight leading-[1.15] text-white">
              <%= slide.title %>
            </h1>

            <!-- Alt Açıklama -->
            <p class="text-base sm:text-xl text-slate-300 leading-relaxed font-normal max-w-2xl">
              <%= slide.subtitle %>
            </p>

            <!-- Butonlar -->
            <div class="pt-4 flex flex-wrap gap-4 items-center">
              <% if (slide.btnPrimaryText) { %>
                <a href="<%= slide.btnPrimaryLink || '/projeler' %>" class="bg-gradient-to-r from-brand-500 to-brand-600 hover:from-brand-600 hover:to-brand-700 text-dark-900 font-extrabold px-8 py-4 rounded-xl shadow-xl shadow-brand-500/25 hover:shadow-brand-500/40 transition-all transform hover:-translate-y-0.5 flex items-center space-x-3 text-base">
                  <span><%= slide.btnPrimaryText %></span>
                  <i class="fa-solid fa-arrow-right text-sm"></i>
                </a>
              <% } %>
              <% if (slide.btnSecondaryText) { %>
                <a href="<%= slide.btnSecondaryLink || '/iletisim' %>" class="bg-slate-800/80 hover:bg-slate-700/90 text-white font-bold px-8 py-4 rounded-xl border border-slate-700 backdrop-blur-md transition-all flex items-center space-x-3 text-base">
                  <i class="fa-solid fa-phone text-brand-500"></i>
                  <span><%= slide.btnSecondaryText %></span>
                </a>
              <% } %>
            </div>

          </div>
        </div>
      </div>
    <% }) %>
  </div>

  <!-- Slider Ok Butonları (Önceki / Sonraki) -->
  <% if (activeSlides.length > 1) { %>
    <button id="sliderPrevBtn" class="absolute left-4 sm:left-8 top-1/2 -translate-y-1/2 z-20 w-12 h-12 rounded-full bg-dark-900/60 hover:bg-brand-500 hover:text-dark-900 text-white border border-slate-700/60 flex items-center justify-center transition-all backdrop-blur-md shadow-xl opacity-0 group-hover:opacity-100 focus:opacity-100" aria-label="Önceki Slayt">
      <i class="fa-solid fa-chevron-left text-base"></i>
    </button>
    <button id="sliderNextBtn" class="absolute right-4 sm:right-8 top-1/2 -translate-y-1/2 z-20 w-12 h-12 rounded-full bg-dark-900/60 hover:bg-brand-500 hover:text-dark-900 text-white border border-slate-700/60 flex items-center justify-center transition-all backdrop-blur-md shadow-xl opacity-0 group-hover:opacity-100 focus:opacity-100" aria-label="Sonraki Slayt">
      <i class="fa-solid fa-chevron-right text-base"></i>
    </button>

    <!-- Slayt Noktaları (Pagination Dots) -->
    <div id="sliderDots" class="absolute bottom-20 md:bottom-24 left-0 right-0 z-20 flex items-center justify-center space-x-2.5">
      <% activeSlides.forEach((_, idx) => { %>
        <button class="slider-dot w-3 h-3 rounded-full transition-all duration-300 <%= idx === 0 ? 'w-8 bg-brand-500' : 'bg-white/40 hover:bg-white/80' %>" data-dot-index="<%= idx %>" aria-label="Slayt <%= idx + 1 %>"></button>
      <% }) %>
    </div>
  <% } %>

  <!-- Hero Alt Sayaçlar (İstatistik Barı) -->
  <div class="absolute bottom-0 left-0 right-0 z-20 bg-dark-850/90 backdrop-blur-md border-t border-slate-800 hidden md:block">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-5">
      <div class="grid grid-cols-4 gap-6 divide-x divide-slate-800">
        <div class="px-4 text-center">
          <div class="text-2xl lg:text-3xl font-extrabold text-brand-400"><%= settings.stats.stat1_number %></div>
          <div class="text-xs text-slate-400 uppercase tracking-wider font-semibold mt-0.5"><%= settings.stats.stat1_label %></div>
        </div>
        <div class="px-4 text-center">
          <div class="text-2xl lg:text-3xl font-extrabold text-brand-400"><%= settings.stats.stat2_number %></div>
          <div class="text-xs text-slate-400 uppercase tracking-wider font-semibold mt-0.5"><%= settings.stats.stat2_label %></div>
        </div>
        <div class="px-4 text-center">
          <div class="text-2xl lg:text-3xl font-extrabold text-brand-400"><%= settings.stats.stat3_number %></div>
          <div class="text-xs text-slate-400 uppercase tracking-wider font-semibold mt-0.5"><%= settings.stats.stat3_label %></div>
        </div>
        <div class="px-4 text-center">
          <div class="text-2xl lg:text-3xl font-extrabold text-brand-400"><%= settings.stats.stat4_number %></div>
          <div class="text-xs text-slate-400 uppercase tracking-wider font-semibold mt-0.5"><%= settings.stats.stat4_label %></div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Mobil Sayaçlar (Mobilde hero altında) -->
<div class="bg-dark-850 text-white py-6 border-b border-slate-800 md:hidden">
  <div class="max-w-7xl mx-auto px-4 grid grid-cols-2 gap-4 text-center">
    <div class="bg-slate-800/60 p-3 rounded-xl">
      <div class="text-2xl font-extrabold text-brand-400"><%= settings.stats.stat1_number %></div>
      <div class="text-[11px] text-slate-400 uppercase font-semibold"><%= settings.stats.stat1_label %></div>
    </div>
    <div class="bg-slate-800/60 p-3 rounded-xl">
      <div class="text-2xl font-extrabold text-brand-400"><%= settings.stats.stat2_number %></div>
      <div class="text-[11px] text-slate-400 uppercase font-semibold"><%= settings.stats.stat2_label %></div>
    </div>
    <div class="bg-slate-800/60 p-3 rounded-xl">
      <div class="text-2xl font-extrabold text-brand-400"><%= settings.stats.stat3_number %></div>
      <div class="text-[11px] text-slate-400 uppercase font-semibold"><%= settings.stats.stat3_label %></div>
    </div>
    <div class="bg-slate-800/60 p-3 rounded-xl">
      <div class="text-2xl font-extrabold text-brand-400"><%= settings.stats.stat4_number %></div>
      <div class="text-[11px] text-slate-400 uppercase font-semibold"><%= settings.stats.stat4_label %></div>
    </div>
  </div>
</div>

<!-- ================= HAKKIMIZDA / KURUMSAL BÖLÜMÜ ================= -->
<section id="hakkimizda" class="py-20 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">
      
      <!-- Sol Görsel & Deneyim Rozeti -->
      <div class="lg:col-span-6 relative">
        <div class="relative rounded-3xl overflow-hidden shadow-2xl group">
          <img src="<%= settings.about.image %>" alt="<%= settings.about.title %>" class="w-full h-[420px] sm:h-[500px] object-cover transition-transform duration-700 group-hover:scale-105">
          <div class="absolute inset-0 bg-gradient-to-t from-dark-900/60 via-transparent to-transparent"></div>
        </div>

        <!-- 25 Yıllık Tecrübe Kartı -->
        <div class="absolute -bottom-6 -right-4 sm:bottom-8 sm:-right-8 bg-dark-900 border-2 border-brand-500 text-white p-6 rounded-2xl shadow-2xl max-w-[220px]">
          <div class="flex items-center space-x-3">
            <div class="text-4xl font-extrabold text-brand-400"><%= settings.stats.stat2_number %></div>
            <div class="text-xs font-bold leading-tight uppercase tracking-wider text-slate-300">
              Yıllık Güvenli Yapı Deneyimi
            </div>
          </div>
        </div>
      </div>

      <!-- Sağ Metin Alanı -->
      <div class="lg:col-span-6 space-y-6">
        <div class="inline-flex items-center space-x-2 text-brand-600 font-extrabold text-xs tracking-wider uppercase">
          <span class="w-8 h-0.5 bg-brand-500"></span>
          <span><%= settings.about.subtitle %></span>
        </div>

        <h2 class="text-3xl sm:text-4xl font-extrabold text-dark-900 tracking-tight leading-tight">
          <%= settings.about.title %>
        </h2>

        <p class="text-slate-600 leading-relaxed text-base">
          <%= settings.about.text1 %>
        </p>

        <p class="text-slate-600 leading-relaxed text-base">
          <%= settings.about.text2 %>
        </p>

        <!-- Vizyon & Misyon Kutuları -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-2">
          <div class="bg-slate-50 border border-slate-200/80 p-5 rounded-2xl hover:border-brand-500/40 transition-colors">
            <div class="w-10 h-10 rounded-xl bg-brand-500/10 text-brand-600 flex items-center justify-center mb-3">
              <i class="fa-solid fa-eye text-lg"></i>
            </div>
            <h4 class="font-bold text-dark-900 text-base mb-1.5">Vizyonumuz</h4>
            <p class="text-xs text-slate-600 leading-relaxed"><%= settings.about.vision %></p>
          </div>

          <div class="bg-slate-50 border border-slate-200/80 p-5 rounded-2xl hover:border-brand-500/40 transition-colors">
            <div class="w-10 h-10 rounded-xl bg-brand-500/10 text-brand-600 flex items-center justify-center mb-3">
              <i class="fa-solid fa-bullseye text-lg"></i>
            </div>
            <h4 class="font-bold text-dark-900 text-base mb-1.5">Misyonumuz</h4>
            <p class="text-xs text-slate-600 leading-relaxed"><%= settings.about.mission %></p>
          </div>
        </div>

        <div class="pt-2">
          <a href="/iletisim" class="inline-flex items-center space-x-2 text-brand-600 font-bold hover:text-brand-700 transition-colors group">
            <span>Kurumsal Detaylar ve Tanışma</span>
            <i class="fa-solid fa-arrow-right text-xs transition-transform group-hover:translate-x-1"></i>
          </a>
        </div>
      </div>

    </div>
  </div>
</section>

<!-- ================= HİZMETLERİMİZ ================= -->
<section class="py-20 bg-slate-100 border-y border-slate-200/80">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-14 space-y-3">
      <div class="inline-flex items-center space-x-2 text-brand-600 font-extrabold text-xs tracking-wider uppercase">
        <span class="w-6 h-0.5 bg-brand-500"></span>
        <span>Hizmet Alanlarımız</span>
        <span class="w-6 h-0.5 bg-brand-500"></span>
      </div>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-dark-900 tracking-tight">
        A'dan Z'ye Anahtar Teslim Çözümler
      </h2>
      <p class="text-slate-600 text-base">
        Ağaoğulları İnşaat olarak her ölçekteki projede yüksek mühendislik kalitesi ve modern teknolojiler kullanıyoruz.
      </p>
    </div>

    <!-- Hizmet Kartları -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      <% services.forEach(service => { %>
        <div class="bg-white rounded-2xl overflow-hidden border border-slate-200/80 shadow-sm hover:shadow-xl transition-all duration-300 group flex flex-col">
          <div class="relative h-48 overflow-hidden">
            <img src="<%= service.image %>" alt="<%= service.title %>" class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-110">
            <div class="absolute inset-0 bg-gradient-to-t from-dark-900/70 via-transparent to-transparent"></div>
            <div class="absolute bottom-4 left-4 w-12 h-12 rounded-xl bg-brand-500 text-dark-900 flex items-center justify-center text-xl shadow-lg">
              <i class="fa-solid <%= service.icon || 'fa-building' %>"></i>
            </div>
          </div>
          <div class="p-6 flex-1 flex flex-col justify-between space-y-3">
            <div>
              <h3 class="text-lg font-bold text-dark-900 group-hover:text-brand-600 transition-colors">
                <%= service.title %>
              </h3>
              <p class="text-sm text-slate-600 mt-2 leading-relaxed">
                <%= service.shortDesc %>
              </p>
            </div>
            <div class="pt-4 border-t border-slate-100 flex items-center justify-between">
              <a href="/hizmetler" class="text-xs font-bold text-brand-600 hover:text-brand-700 transition-colors flex items-center space-x-1">
                <span>Detaylı Bilgi</span>
                <i class="fa-solid fa-angle-right text-xs"></i>
              </a>
              <a href="/iletisim" class="text-xs font-semibold text-slate-400 hover:text-dark-900 transition-colors">
                Teklif İste
              </a>
            </div>
          </div>
        </div>
      <% }) %>
    </div>

  </div>
</section>

<!-- ================= PROJELERİMİZ / PORTFOLYO ================= -->
<section class="py-20 bg-white" id="projeler">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-12 gap-6">
      <div class="space-y-3 max-w-2xl">
        <div class="inline-flex items-center space-x-2 text-brand-600 font-extrabold text-xs tracking-wider uppercase">
          <span class="w-6 h-0.5 bg-brand-500"></span>
          <span>Seçkin Portfolyomuz</span>
        </div>
        <h2 class="text-3xl sm:text-4xl font-extrabold text-dark-900 tracking-tight">
          İmzamızı Taşıyan Öncü Projeler
        </h2>
        <p class="text-slate-600 text-base">
          Konuttan endüstriyel tesislere, kentsel dönüşümden prestijli iş kulelerine tamamlanan ve devam eden projelerimiz.
        </p>
      </div>

      <!-- Filtre Butonları -->
      <div class="flex flex-wrap gap-2" id="projectFilter">
        <button class="filter-btn active px-4 py-2 rounded-xl text-xs font-bold transition-all bg-dark-900 text-white" data-category="all">
          Tümü
        </button>
        <button class="filter-btn px-4 py-2 rounded-xl text-xs font-bold transition-all bg-slate-100 text-slate-600 hover:bg-slate-200" data-category="Konut">
          Konut
        </button>
        <button class="filter-btn px-4 py-2 rounded-xl text-xs font-bold transition-all bg-slate-100 text-slate-600 hover:bg-slate-200" data-category="Ticari">
          Ticari
        </button>
        <button class="filter-btn px-4 py-2 rounded-xl text-xs font-bold transition-all bg-slate-100 text-slate-600 hover:bg-slate-200" data-category="Endüstriyel">
          Endüstriyel
        </button>
      </div>
    </div>

    <!-- Proje Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8" id="projectsGrid">
      <% projects.forEach(project => { %>
        <div class="project-card group bg-white rounded-2xl overflow-hidden border border-slate-200/80 shadow-md hover:shadow-2xl transition-all duration-300 flex flex-col" data-category="<%= project.category %>">
          <div class="relative h-64 overflow-hidden">
            <img src="<%= project.image %>" alt="<%= project.title %>" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110">
            
            <!-- Durum ve Kategori Etiketleri -->
            <div class="absolute top-4 left-4 flex flex-wrap gap-2">
              <span class="px-3 py-1 rounded-full text-[11px] font-extrabold uppercase tracking-wider <%= project.status === 'Tamamlandı' ? 'bg-emerald-500 text-white' : 'bg-brand-500 text-dark-900' %> shadow-md">
                <%= project.status %>
              </span>
              <span class="px-3 py-1 rounded-full text-[11px] font-bold bg-dark-900/80 backdrop-blur-md text-white shadow-md">
                <%= project.category %>
              </span>
            </div>

            <% if (project.images && project.images.length > 1) { %>
              <div class="absolute top-4 right-4 z-10">
                <span class="px-2.5 py-1 rounded-full text-[11px] font-bold bg-dark-900/80 backdrop-blur-md text-white shadow-md flex items-center space-x-1.5">
                  <i class="fa-solid fa-images text-brand-400"></i>
                  <span><%= project.images.length %></span>
                </span>
              </div>
            <% } %>

            <!-- Konum & Yıl Rozeti -->
            <div class="absolute bottom-4 left-4 right-4 flex justify-between items-center text-white text-xs font-medium z-10">
              <span class="flex items-center space-x-1.5 drop-shadow">
                <i class="fa-solid fa-location-dot text-brand-400"></i>
                <span><%= project.location %></span>
              </span>
              <span class="flex items-center space-x-1.5 drop-shadow">
                <i class="fa-regular fa-calendar text-brand-400"></i>
                <span><%= project.year %></span>
              </span>
            </div>
            <div class="absolute inset-0 bg-gradient-to-t from-dark-900/80 via-transparent to-transparent"></div>
          </div>

          <div class="p-6 flex-1 flex flex-col justify-between space-y-4">
            <div>
              <h3 class="text-xl font-bold text-dark-900 group-hover:text-brand-600 transition-colors">
                <a href="/proje/<%= project.id %>"><%= project.title %></a>
              </h3>
              <p class="text-sm text-slate-600 mt-2 line-clamp-2">
                <%= project.description %>
              </p>
            </div>
            
            <div class="pt-4 border-t border-slate-100 flex items-center justify-between">
              <a href="/proje/<%= project.id %>" class="text-xs font-bold text-dark-900 hover:text-brand-600 transition-colors flex items-center space-x-1">
                <span>Detayları İncele</span>
                <i class="fa-solid fa-arrow-right text-xs"></i>
              </a>
              <a href="/iletisim" class="text-xs font-semibold text-brand-600 hover:text-brand-700">
                Benzer Proje Teklifi
              </a>
            </div>
          </div>
        </div>
      <% }) %>
    </div>

    <div class="text-center mt-12">
      <a href="/projeler" class="inline-flex items-center space-x-2 bg-slate-900 hover:bg-slate-800 text-white font-bold px-8 py-3.5 rounded-xl shadow-lg transition-all">
        <span>Tüm Projeleri Görüntüle</span>
        <i class="fa-solid fa-arrow-right text-xs text-brand-400"></i>
      </a>
    </div>

  </div>
</section>

<!-- ================= NEDEN AĞAOĞULLARI İNŞAAT? ================= -->
<section class="py-20 bg-dark-900 text-white relative overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="text-center max-w-3xl mx-auto mb-16 space-y-3">
      <div class="inline-flex items-center space-x-2 text-brand-400 font-extrabold text-xs tracking-wider uppercase">
        <span class="w-6 h-0.5 bg-brand-500"></span>
        <span>Güvencemiz</span>
        <span class="w-6 h-0.5 bg-brand-500"></span>
      </div>
      <h2 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-white">
        Neden Ağaoğulları İnşaat?
      </h2>
      <p class="text-slate-400 text-base">
        Her metrekarede sıfır toleranslı kalite, şeffaf yönetim ve deprem güvenliği odaklı mimari.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
      
      <div class="bg-dark-850 p-6 rounded-2xl border border-slate-800 hover:border-brand-500/50 transition-all group">
        <div class="w-14 h-14 rounded-xl bg-brand-500/10 text-brand-400 flex items-center justify-center text-2xl mb-5 group-hover:scale-110 transition-transform">
          <i class="fa-solid fa-shield-halved"></i>
        </div>
        <h4 class="text-lg font-bold text-white mb-2">Depreme Tam Dayanıklılık</h4>
        <p class="text-sm text-slate-400 leading-relaxed">
          En son Türkiye Bina Deprem Yönetmeliği standartlarının üzerinde statik hesaplama ve zemin iyileştirme çözümleri.
        </p>
      </div>

      <div class="bg-dark-850 p-6 rounded-2xl border border-slate-800 hover:border-brand-500/50 transition-all group">
        <div class="w-14 h-14 rounded-xl bg-brand-500/10 text-brand-400 flex items-center justify-center text-2xl mb-5 group-hover:scale-110 transition-transform">
          <i class="fa-solid fa-clock-rotate-left"></i>
        </div>
        <h4 class="text-lg font-bold text-white mb-2">Zamanında Teslim</h4>
        <p class="text-sm text-slate-400 leading-relaxed">
          Sözleşmeye bağlı katı iş programı yönetimi ile projelerinizi taahhüt edilen tarihte eksiksiz teslim ediyoruz.
        </p>
      </div>

      <div class="bg-dark-850 p-6 rounded-2xl border border-slate-800 hover:border-brand-500/50 transition-all group">
        <div class="w-14 h-14 rounded-xl bg-brand-500/10 text-brand-400 flex items-center justify-center text-2xl mb-5 group-hover:scale-110 transition-transform">
          <i class="fa-solid fa-certificate"></i>
        </div>
        <h4 class="text-lg font-bold text-white mb-2">1. Sınıf Malzeme</h4>
