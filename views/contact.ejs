<%- include('partials/head') %>
<%- include('partials/topbar') %>
<%- include('partials/navbar') %>

<!-- Banner -->
<section class="relative bg-dark-900 text-white py-20 overflow-hidden">
  <div class="absolute inset-0 z-0">
    <img src="https://images.unsplash.com/photo-1486406146926-c627a92ad1ab?q=80&w=2070&auto=format&fit=crop" alt="İletişim" class="w-full h-full object-cover filter brightness-35">
    <div class="absolute inset-0 bg-gradient-to-t from-dark-900 via-dark-900/60 to-transparent"></div>
  </div>
  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-4">
    <div class="inline-flex items-center space-x-2 text-brand-400 font-extrabold text-xs tracking-wider uppercase">
      <a href="/" class="hover:text-white transition-colors">Anasayfa</a>
      <span class="text-slate-600">/</span>
      <span>İletişim</span>
    </div>
    <h1 class="text-4xl sm:text-5xl font-extrabold text-white tracking-tight">
      Bizimle İletişime Geçin
    </h1>
    <p class="text-slate-300 text-base max-w-2xl mx-auto">
      Projeleriniz, iş ortaklığı veya teknik danışmanlık talepleriniz için bize dilediğiniz zaman ulaşabilirsiniz.
    </p>
  </div>
</section>

<% if (typeof successMsg !== 'undefined' && successMsg) { %>
  <div class="bg-emerald-600 text-white px-4 py-4 text-center text-sm font-semibold shadow-md flex items-center justify-center space-x-2">
    <i class="fa-solid fa-circle-check text-xl"></i>
    <span><%= successMsg %></span>
  </div>
<% } %>

<!-- İletişim Detayları ve Form -->
<section class="py-20 bg-slate-50 min-h-screen">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">
      
      <!-- Sol: İletişim Bilgi Kartları -->
      <div class="lg:col-span-5 space-y-6">
        <div class="bg-white p-8 rounded-3xl border border-slate-200/80 shadow-md space-y-6">
          <h2 class="text-2xl font-bold text-dark-900">Genel Merkez & Şantiye Yönetimi</h2>
          <p class="text-slate-600 text-sm leading-relaxed">
            Ofisimizde sizleri ağırlamaktan ve projelerinizi yüz yüze değerlendirmekten memnuniyet duyarız.
          </p>

          <div class="space-y-5 pt-2">
            
            <div class="flex items-start space-x-4">
              <div class="w-12 h-12 rounded-2xl bg-brand-500/10 text-brand-600 flex items-center justify-center text-xl shrink-0 mt-1">
                <i class="fa-solid fa-location-dot"></i>
              </div>
              <div>
                <h4 class="text-xs font-bold text-slate-500 uppercase tracking-wider">Adres</h4>
                <p class="text-dark-900 font-semibold text-sm mt-0.5"><%= settings.address %></p>
              </div>
            </div>

            <div class="flex items-start space-x-4">
              <div class="w-12 h-12 rounded-2xl bg-brand-500/10 text-brand-600 flex items-center justify-center text-xl shrink-0 mt-1">
                <i class="fa-solid fa-phone"></i>
              </div>
              <div>
                <h4 class="text-xs font-bold text-slate-500 uppercase tracking-wider">Telefon</h4>
                <p class="text-dark-900 font-semibold text-sm mt-0.5">
                  <a href="tel:<%= settings.phone.replace(/[^0-9+]/g, '') %>" class="hover:text-brand-600"><%= settings.phone %></a>
                  <% if (settings.phone2) { %>
                    <br><a href="tel:<%= settings.phone2.replace(/[^0-9+]/g, '') %>" class="hover:text-brand-600 text-slate-600"><%= settings.phone2 %></a>
                  <% } %>
                </p>
              </div>
            </div>

            <div class="flex items-start space-x-4">
              <div class="w-12 h-12 rounded-2xl bg-brand-500/10 text-brand-600 flex items-center justify-center text-xl shrink-0 mt-1">
                <i class="fa-solid fa-envelope"></i>
              </div>
              <div>
                <h4 class="text-xs font-bold text-slate-500 uppercase tracking-wider">E-Posta</h4>
                <p class="text-dark-900 font-semibold text-sm mt-0.5">
                  <a href="mailto:<%= settings.email %>" class="hover:text-brand-600"><%= settings.email %></a>
                </p>
              </div>
            </div>

            <div class="flex items-start space-x-4">
              <div class="w-12 h-12 rounded-2xl bg-brand-500/10 text-brand-600 flex items-center justify-center text-xl shrink-0 mt-1">
                <i class="fa-regular fa-clock"></i>
              </div>
              <div>
                <h4 class="text-xs font-bold text-slate-500 uppercase tracking-wider">Çalışma Saatleri</h4>
                <p class="text-dark-900 font-semibold text-sm mt-0.5"><%= settings.workingHours %></p>
              </div>
            </div>

          </div>

          <% if (settings.whatsapp) { %>
            <div class="pt-4 border-t border-slate-100">
              <a href="https://wa.me/<%= settings.whatsapp.replace(/[^0-9]/g, '') %>" target="_blank" rel="noopener noreferrer" class="w-full bg-emerald-500 hover:bg-emerald-600 text-white font-bold py-3.5 px-4 rounded-xl flex items-center justify-center space-x-2 transition-all shadow-lg text-sm">
                <i class="fa-brands fa-whatsapp text-lg"></i>
                <span>WhatsApp İle Hızlı Mesaj Gönder</span>
              </a>
            </div>
          <% } %>

        </div>
      </div>

      <!-- Sağ: Mesaj Gönderme Formu -->
      <div class="lg:col-span-7 bg-white p-8 sm:p-12 rounded-3xl border border-slate-200/80 shadow-md">
        <h2 class="text-2xl font-bold text-dark-900 mb-2">Bize Mesaj Gönderin</h2>
        <p class="text-sm text-slate-600 mb-8">Form üzerinden gönderilen mesajlar doğrudan yönetim panelimize iletilir ve en geç 24 saat içinde yanıtlanır.</p>

        <form action="/iletisim" method="POST" class="space-y-5">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
            <div>
              <label class="block text-xs font-bold text-slate-700 uppercase mb-1.5">Adınız Soyadınız *</label>
              <input type="text" name="name" required class="w-full px-4 py-3.5 rounded-xl border border-slate-300 focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-brand-500 text-sm bg-slate-50" placeholder="Adınız Soyadınız">
            </div>
            <div>
              <label class="block text-xs font-bold text-slate-700 uppercase mb-1.5">Telefon Numaranız *</label>
              <input type="tel" name="phone" required class="w-full px-4 py-3.5 rounded-xl border border-slate-300 focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-brand-500 text-sm bg-slate-50" placeholder="05XX XXX XX XX">
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
            <div>
              <label class="block text-xs font-bold text-slate-700 uppercase mb-1.5">E-Posta Adresiniz *</label>
              <input type="email" name="email" required class="w-full px-4 py-3.5 rounded-xl border border-slate-300 focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-brand-500 text-sm bg-slate-50" placeholder="ornek@alanadi.com">
            </div>
            <div>
              <label class="block text-xs font-bold text-slate-700 uppercase mb-1.5">Konu / Hizmet Türü</label>
              <select name="subject" class="w-full px-4 py-3.5 rounded-xl border border-slate-300 focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-brand-500 text-sm bg-slate-50">
                <option value="Kentsel Dönüşüm Talebi">Kentsel Dönüşüm Talebi</option>
                <option value="Konut & Rezidans Projesi">Konut & Rezidans Projesi</option>
                <option value="Sanayi & Fabrika İnşaatı">Sanayi & Fabrika İnşaatı</option>
                <option value="Mimari Çizim & Ruhsat">Mimari Çizim & Ruhsat</option>
                <option value="Genel Bilgi Talebi">Genel Bilgi Talebi</option>
              </select>
            </div>
          </div>

          <div>
            <label class="block text-xs font-bold text-slate-700 uppercase mb-1.5">Mesajınız *</label>
            <textarea name="message" rows="5" required class="w-full px-4 py-3.5 rounded-xl border border-slate-300 focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-brand-500 text-sm bg-slate-50" placeholder="Projeniz hakkında detaylar veya sormak istedikleriniz..."></textarea>
          </div>

          <button type="submit" class="w-full bg-brand-500 hover:bg-brand-600 text-dark-900 font-extrabold py-4 rounded-xl shadow-lg transition-all text-base flex items-center justify-center space-x-2">
            <i class="fa-solid fa-paper-plane"></i>
            <span>Mesajı Gönder</span>
          </button>
        </form>
      </div>

    </div>

    <!-- Harita Bölümü -->
    <% if (settings.mapsEmbed) { %>
      <div class="mt-16 rounded-3xl overflow-hidden shadow-xl border border-slate-200">
        <iframe src="<%= settings.mapsEmbed %>" width="100%" height="450" style="border:0;" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
      </div>
    <% } %>

  </div>
</section>

<%- include('partials/footer') %>

