<%- include('partials/head') %>
<%- include('partials/topbar') %>
<%- include('partials/navbar') %>

<!-- Banner -->
<section class="relative bg-dark-900 text-white py-20 overflow-hidden">
  <div class="absolute inset-0 z-0">
    <img src="https://images.unsplash.com/photo-1503387762-592deb58ef4e?q=80&w=2070&auto=format&fit=crop" alt="Hizmetlerimiz" class="w-full h-full object-cover filter brightness-35">
    <div class="absolute inset-0 bg-gradient-to-t from-dark-900 via-dark-900/60 to-transparent"></div>
  </div>
  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-4">
    <div class="inline-flex items-center space-x-2 text-brand-400 font-extrabold text-xs tracking-wider uppercase">
      <a href="/" class="hover:text-white transition-colors">Anasayfa</a>
      <span class="text-slate-600">/</span>
      <span>Hizmetlerimiz</span>
    </div>
    <h1 class="text-4xl sm:text-5xl font-extrabold text-white tracking-tight">
      Kapsamlı İnşaat & Taahhüt Hizmetleri
    </h1>
    <p class="text-slate-300 text-base max-w-2xl mx-auto">
      Planlamadan projelendirmeye, kaba inşaattan ince işçiliklere kadar anahtar teslim uzmanlık.
    </p>
  </div>
</section>

<!-- Hizmetler Detay Listesi -->
<section class="py-20 bg-slate-50 min-h-screen">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-16">
    <% services.forEach((service, index) => { %>
      <div class="bg-white rounded-3xl p-8 sm:p-12 border border-slate-200/80 shadow-md hover:shadow-xl transition-all">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
          
          <div class="lg:col-span-6 <%= index % 2 === 1 ? 'lg:order-2' : '' %>">
            <div class="relative rounded-2xl overflow-hidden shadow-lg h-72 sm:h-96">
              <img src="<%= service.image %>" alt="<%= service.title %>" class="w-full h-full object-cover">
              <div class="absolute top-4 left-4 w-12 h-12 rounded-xl bg-brand-500 text-dark-900 flex items-center justify-center text-xl shadow-lg">
                <i class="fa-solid <%= service.icon || 'fa-building' %>"></i>
              </div>
            </div>
          </div>

          <div class="lg:col-span-6 <%= index % 2 === 1 ? 'lg:order-1' : '' %> space-y-5">
            <div class="inline-flex items-center space-x-2 text-brand-600 font-extrabold text-xs tracking-wider uppercase">
              <span class="w-6 h-0.5 bg-brand-500"></span>
              <span>Hizmet Alanı #0<%= index + 1 %></span>
            </div>
            <h2 class="text-2xl sm:text-3xl font-extrabold text-dark-900 tracking-tight">
              <%= service.title %>
            </h2>
            <p class="text-slate-700 text-base font-medium leading-relaxed">
              <%= service.shortDesc %>
            </p>
            <p class="text-slate-600 text-sm leading-relaxed">
              <%= service.description %>
            </p>
            <div class="pt-2">
              <a href="/iletisim" class="inline-flex items-center space-x-2 bg-dark-900 hover:bg-brand-500 hover:text-dark-900 text-white font-bold px-6 py-3 rounded-xl transition-all text-sm shadow-md">
                <span>Bu Hizmet İçin Teklif Alın</span>
                <i class="fa-solid fa-arrow-right text-xs"></i>
              </a>
            </div>
          </div>

        </div>
      </div>
    <% }) %>
  </div>
</section>

<%- include('partials/footer') %>

