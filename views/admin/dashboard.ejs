<%- include('header') %>

<!-- Metrik Kartları -->
<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-5 gap-6 mb-8">
  
  <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm flex items-center justify-between">
    <div>
      <p class="text-xs font-bold text-slate-500 uppercase tracking-wider">Toplam Proje</p>
      <h3 class="text-3xl font-extrabold text-dark-900 mt-1"><%= stats.projectsCount %></h3>
      <a href="/admin/projects" class="text-xs font-semibold text-brand-600 hover:text-brand-700 mt-2 inline-block">Yönet & Fotoğraf Yükle →</a>
    </div>
    <div class="w-12 h-12 rounded-xl bg-amber-50 text-brand-600 flex items-center justify-center text-xl">
      <i class="fa-solid fa-camera-retro"></i>
    </div>
  </div>

  <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm flex items-center justify-between">
    <div>
      <p class="text-xs font-bold text-slate-500 uppercase tracking-wider">Aktif Slaytlar</p>
      <h3 class="text-3xl font-extrabold text-dark-900 mt-1"><%= stats.slidersCount || 3 %></h3>
      <a href="/admin/sliders" class="text-xs font-semibold text-brand-600 hover:text-brand-700 mt-2 inline-block">Slider'ı Yönet →</a>
    </div>
    <div class="w-12 h-12 rounded-xl bg-indigo-50 text-indigo-600 flex items-center justify-center text-xl">
      <i class="fa-solid fa-images"></i>
    </div>
  </div>

  <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm flex items-center justify-between">
    <div>
      <p class="text-xs font-bold text-slate-500 uppercase tracking-wider">Dinamik Sayfalar</p>
      <h3 class="text-3xl font-extrabold text-dark-900 mt-1"><%= stats.pagesCount %></h3>
      <a href="/admin/pages" class="text-xs font-semibold text-brand-600 hover:text-brand-700 mt-2 inline-block">Sayfa Ekle / Çıkar →</a>
    </div>
    <div class="w-12 h-12 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center text-xl">
      <i class="fa-solid fa-file-lines"></i>
    </div>
  </div>

  <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm flex items-center justify-between">
    <div>
      <p class="text-xs font-bold text-slate-500 uppercase tracking-wider">Hizmet Alanları</p>
      <h3 class="text-3xl font-extrabold text-dark-900 mt-1"><%= stats.servicesCount %></h3>
      <a href="/admin/services" class="text-xs font-semibold text-brand-600 hover:text-brand-700 mt-2 inline-block">Hizmetleri Düzenle →</a>
    </div>
    <div class="w-12 h-12 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center text-xl">
      <i class="fa-solid fa-trowel-bricks"></i>
    </div>
  </div>

  <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm flex items-center justify-between">
    <div>
      <p class="text-xs font-bold text-slate-500 uppercase tracking-wider">Gelen Mesajlar</p>
      <div class="flex items-center space-x-2 mt-1">
        <h3 class="text-3xl font-extrabold text-dark-900"><%= stats.messagesCount %></h3>
        <% if (stats.unreadMessages > 0) { %>
          <span class="px-2 py-0.5 rounded-full text-xs font-bold bg-rose-500 text-white"><%= stats.unreadMessages %> yeni</span>
        <% } %>
      </div>
      <a href="/admin/messages" class="text-xs font-semibold text-brand-600 hover:text-brand-700 mt-2 inline-block">Mesajları İncele →</a>
    </div>
    <div class="w-12 h-12 rounded-xl bg-purple-50 text-purple-600 flex items-center justify-center text-xl">
      <i class="fa-solid fa-envelope-open-text"></i>
    </div>
  </div>

</div>

<!-- Hızlı Eylemler & Kısayollar -->
<div class="bg-gradient-to-r from-dark-900 via-dark-850 to-slate-900 text-white rounded-3xl p-8 mb-8 shadow-xl">
  <h3 class="text-lg font-bold mb-2 flex items-center space-x-2">
    <i class="fa-solid fa-bolt text-brand-500"></i>
    <span>Hızlı İşlemler</span>
  </h3>
  <p class="text-xs text-slate-400 mb-6">Web sitenizde en sık gerçekleştireceğiniz yönetimsel işlemler:</p>
  
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-4">
    <a href="/admin/sliders" class="bg-dark-800/80 hover:bg-dark-800 border border-slate-700/80 p-4 rounded-2xl flex items-center space-x-3 transition-all group">
      <div class="w-10 h-10 rounded-xl bg-indigo-500/20 text-indigo-400 flex items-center justify-center group-hover:scale-110 transition-transform">
        <i class="fa-solid fa-images"></i>
      </div>
      <div>
        <div class="text-sm font-bold text-white group-hover:text-brand-400 transition-colors">Slider Düzenle</div>
        <div class="text-[11px] text-slate-400">Anasayfa slayt yönetimi</div>
      </div>
    </a>

    <a href="/admin/settings" class="bg-dark-800/80 hover:bg-dark-800 border border-slate-700/80 p-4 rounded-2xl flex items-center space-x-3 transition-all group">
      <div class="w-10 h-10 rounded-xl bg-brand-500/20 text-brand-400 flex items-center justify-center group-hover:scale-110 transition-transform">
        <i class="fa-solid fa-image"></i>
      </div>
      <div>
        <div class="text-sm font-bold text-white group-hover:text-brand-400 transition-colors">Logo Değiştir</div>
        <div class="text-[11px] text-slate-400">Yeni logo ve favicon yükle</div>
      </div>
    </a>

    <a href="/admin/projects" class="bg-dark-800/80 hover:bg-dark-800 border border-slate-700/80 p-4 rounded-2xl flex items-center space-x-3 transition-all group">
      <div class="w-10 h-10 rounded-xl bg-amber-500/20 text-amber-400 flex items-center justify-center group-hover:scale-110 transition-transform">
        <i class="fa-solid fa-cloud-arrow-up"></i>
      </div>
      <div>
        <div class="text-sm font-bold text-white group-hover:text-brand-400 transition-colors">Fotoğraf Yükle</div>
        <div class="text-[11px] text-slate-400">Yeni proje & galeri fotoğrafı</div>
      </div>
    </a>

    <a href="/admin/content" class="bg-dark-800/80 hover:bg-dark-800 border border-slate-700/80 p-4 rounded-2xl flex items-center space-x-3 transition-all group">
      <div class="w-10 h-10 rounded-xl bg-emerald-500/20 text-emerald-400 flex items-center justify-center group-hover:scale-110 transition-transform">
        <i class="fa-solid fa-pen-nib"></i>
      </div>
      <div>
        <div class="text-sm font-bold text-white group-hover:text-brand-400 transition-colors">Yazıları Düzenle</div>
        <div class="text-[11px] text-slate-400">Hero, hakkımızda & sayaçlar</div>
      </div>
    </a>

    <a href="/admin/pages/new" class="bg-dark-800/80 hover:bg-dark-800 border border-slate-700/80 p-4 rounded-2xl flex items-center space-x-3 transition-all group">
      <div class="w-10 h-10 rounded-xl bg-blue-500/20 text-blue-400 flex items-center justify-center group-hover:scale-110 transition-transform">
        <i class="fa-solid fa-plus"></i>
      </div>
      <div>
        <div class="text-sm font-bold text-white group-hover:text-brand-400 transition-colors">Yeni Sayfa Ekle</div>
        <div class="text-[11px] text-slate-400">Menüye özel sayfa bağla</div>
      </div>
    </a>
  </div>
</div>

<!-- İki Kolon: Son Mesajlar ve Son Projeler -->
<div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
  
  <!-- Son Gelen İletişim Talepleri -->
  <div class="lg:col-span-7 bg-white rounded-2xl border border-slate-200 shadow-sm p-6">
    <div class="flex items-center justify-between pb-4 border-b border-slate-100 mb-4">
      <h4 class="font-bold text-dark-900 text-base flex items-center space-x-2">
        <i class="fa-solid fa-envelope text-brand-500"></i>
        <span>Son Gelen Mesajlar</span>
      </h4>
      <a href="/admin/messages" class="text-xs font-semibold text-brand-600 hover:underline">Tümünü Gör (<%= stats.messagesCount %>)</a>
    </div>

    <% if (recentMessages && recentMessages.length > 0) { %>
      <div class="divide-y divide-slate-100">
        <% recentMessages.forEach(msg => { %>
          <div class="py-3.5 flex items-start justify-between gap-4">
            <div class="space-y-1 min-w-0">
              <div class="flex items-center space-x-2">
                <span class="font-bold text-sm text-dark-900"><%= msg.name %></span>
                <% if (!msg.read) { %>
                  <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-rose-500 text-white">Yeni</span>
                <% } %>
              </div>
              <div class="text-xs text-slate-500 flex items-center space-x-3">
                <span><i class="fa-solid fa-phone text-[10px] mr-1"></i><%= msg.phone || '-' %></span>
                <span><i class="fa-solid fa-tag text-[10px] mr-1"></i><%= msg.subject %></span>
              </div>
              <p class="text-xs text-slate-600 line-clamp-1"><%= msg.message %></p>
            </div>
            <span class="text-[11px] text-slate-400 whitespace-nowrap">
              <%= new Date(msg.createdAt).toLocaleDateString('tr-TR') %>
            </span>
          </div>
        <% }) %>
      </div>
    <% } else { %>
      <div class="text-center py-10 text-slate-400 text-sm">Henüz gelen bir mesaj bulunmuyor.</div>
    <% } %>
  </div>

  <!-- Son Eklenen Projeler -->
  <div class="lg:col-span-5 bg-white rounded-2xl border border-slate-200 shadow-sm p-6">
    <div class="flex items-center justify-between pb-4 border-b border-slate-100 mb-4">
      <h4 class="font-bold text-dark-900 text-base flex items-center space-x-2">
        <i class="fa-solid fa-building text-brand-500"></i>
        <span>Projeler & Portfolyo</span>
      </h4>
      <a href="/admin/projects" class="text-xs font-semibold text-brand-600 hover:underline">Tümünü Gör (<%= stats.projectsCount %>)</a>
    </div>

    <% if (recentProjects && recentProjects.length > 0) { %>
      <div class="space-y-3">
        <% recentProjects.forEach(prj => { %>
          <div class="flex items-center space-x-3 p-2 rounded-xl hover:bg-slate-50 transition-colors">
            <img src="<%= prj.image %>" alt="<%= prj.title %>" class="w-14 h-14 rounded-lg object-cover shrink-0 border border-slate-200">
            <div class="min-w-0 flex-1">
              <h5 class="text-sm font-bold text-dark-900 truncate"><%= prj.title %></h5>
              <div class="text-xs text-slate-500 flex items-center space-x-2 mt-0.5">
                <span><%= prj.category %></span>
                <span>•</span>
                <span class="<%= prj.status === 'Tamamlandı' ? 'text-emerald-600 font-semibold' : 'text-amber-600 font-semibold' %>"><%= prj.status %></span>
              </div>
            </div>
          </div>
        <% }) %>
      </div>
    <% } else { %>
      <div class="text-center py-10 text-slate-400 text-sm">Henüz kayıtlı proje yok.</div>
    <% } %>
  </div>

</div>

<%- include('footer') %>

