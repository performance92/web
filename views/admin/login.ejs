<!DOCTYPE html>
<html lang="tr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Yönetici Girişi | <%= settings.siteTitle %></title>
  
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            sans: ['"Plus Jakarta Sans"', 'sans-serif'],
          },
          colors: {
            brand: {
              500: '#f59e0b',
              600: '#d97706',
            },
            dark: {
              900: '#0b1120',
              850: '#0f172a',
            }
          }
        }
      }
    }
  </script>
</head>
<body class="bg-dark-900 font-sans min-h-screen flex items-center justify-center p-4 relative overflow-hidden">
  
  <!-- Arka Plan Efekti -->
  <div class="absolute inset-0 z-0 opacity-20">
    <img src="https://images.unsplash.com/photo-1541888946425-d0fbb186156f?q=80&w=2070&auto=format&fit=crop" alt="Arka Plan" class="w-full h-full object-cover">
    <div class="absolute inset-0 bg-dark-900/90"></div>
  </div>

  <div class="relative z-10 w-full max-w-md">
    <!-- Kart -->
    <div class="bg-dark-850 border border-slate-800 rounded-3xl p-8 sm:p-10 shadow-2xl space-y-6">
      
      <!-- Başlık & Logo -->
      <div class="text-center space-y-3">
        <% if (settings.logoUrl) { %>
          <img src="<%= settings.logoUrl %>" alt="Logo" class="h-12 w-auto mx-auto object-contain">
        <% } else { %>
          <div class="w-16 h-16 rounded-2xl bg-brand-500 text-dark-900 flex items-center justify-center text-3xl mx-auto shadow-xl shadow-brand-500/20 font-bold">
            <i class="fa-solid fa-helmet-safety"></i>
          </div>
        <% } %>
        <h1 class="text-2xl font-extrabold text-white tracking-tight"><%= settings.siteTitle %></h1>
        <p class="text-xs text-slate-400">Yönetim paneline erişmek için bilgilerinizi giriniz.</p>
      </div>

      <!-- Hata Bildirimi -->
      <% if (typeof error !== 'undefined' && error) { %>
        <div class="p-4 rounded-xl bg-rose-500/10 border border-rose-500/30 text-rose-400 text-xs font-semibold flex items-center space-x-2">
          <i class="fa-solid fa-circle-exclamation text-sm"></i>
          <span><%= error %></span>
        </div>
      <% } %>

      <!-- Giriş Formu -->
      <form action="/admin/login" method="POST" class="space-y-4">
        <div>
          <label class="block text-xs font-bold text-slate-300 uppercase mb-1.5">Kullanıcı Adı</label>
          <div class="relative">
            <span class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-500">
              <i class="fa-solid fa-user text-xs"></i>
            </span>
            <input type="text" name="username" required class="w-full pl-10 pr-4 py-3 bg-dark-900 border border-slate-700 rounded-xl text-white text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-brand-500 placeholder-slate-500" placeholder="Kullanıcı adınızı girin">
          </div>
        </div>

        <div>
          <label class="block text-xs font-bold text-slate-300 uppercase mb-1.5">Şifre</label>
          <div class="relative">
            <span class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-500">
              <i class="fa-solid fa-lock text-xs"></i>
            </span>
            <input type="password" name="password" required class="w-full pl-10 pr-4 py-3 bg-dark-900 border border-slate-700 rounded-xl text-white text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-brand-500 placeholder-slate-500" placeholder="Şifrenizi girin">
          </div>
        </div>

        <button type="submit" class="w-full bg-gradient-to-r from-brand-500 to-brand-600 hover:from-brand-600 hover:to-brand-700 text-dark-900 font-extrabold py-3.5 rounded-xl shadow-lg shadow-brand-500/25 transition-all text-sm flex items-center justify-center space-x-2">
          <span>Giriş Yap</span>
          <i class="fa-solid fa-arrow-right text-xs"></i>
        </button>
      </form>

      <div class="pt-4 border-t border-slate-800 text-center">
        <a href="/" class="text-xs text-slate-400 hover:text-white transition-colors flex items-center justify-center space-x-1">
          <i class="fa-solid fa-arrow-left text-[10px]"></i>
          <span>Web Sitesine Geri Dön</span>
        </a>
      </div>

    </div>
  </div>

</body>
</html>

