<!DOCTYPE html>
<html lang="tr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof pageTitle !== 'undefined' ? pageTitle : 'Yönetim Paneli' %> | <%= currentSettings.siteTitle %></title>
  
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            sans: ['"Plus Jakarta Sans"', 'sans-serif'],
          },
          colors: {
            brand: {
              500: '#f59e0b',
              600: '#d97706',
            },
            dark: {
              900: '#0b1120',
              850: '#0f172a',
              800: '#1e293b',
              700: '#334155',
            }
          }
        }
      }
    }
  </script>
</head>
<body class="bg-slate-100 font-sans text-slate-800 antialiased min-h-screen flex flex-col md:flex-row">

  <!-- Mobil Admin Navbar -->
  <div class="md:hidden bg-dark-900 text-white px-4 py-3 flex items-center justify-between border-b border-slate-800 sticky top-0 z-50">
    <div class="flex items-center space-x-2">
      <div class="w-8 h-8 rounded-lg bg-brand-500 text-dark-900 flex items-center justify-center font-bold">
        <i class="fa-solid fa-helmet-safety text-sm"></i>
      </div>
      <span class="font-bold text-sm tracking-tight text-white"><%= currentSettings.siteTitle %></span>
    </div>
    <button id="adminMobileToggle" class="p-2 rounded-lg text-slate-300 hover:text-white hover:bg-slate-800">
      <i class="fa-solid fa-bars text-lg"></i>
    </button>
  </div>

  <!-- Sol Sidebar -->
  <aside id="adminSidebar" class="w-full md:w-64 bg-dark-900 text-slate-300 shrink-0 hidden md:flex flex-col border-r border-slate-800 min-h-screen z-40">
    <!-- Sidebar Logo / Başlık -->
    <div class="p-6 border-b border-slate-800">
      <a href="/admin" class="flex items-center space-x-3">
        <% if (currentSettings.logoUrl) { %>
          <img src="<%= currentSettings.logoUrl %>" alt="Logo" class="h-9 w-auto max-w-[150px] object-contain">
        <% } else { %>
          <div class="w-10 h-10 rounded-xl bg-brand-500 text-dark-900 flex items-center justify-center font-bold text-xl shadow-lg">
            <i class="fa-solid fa-helmet-safety"></i>
          </div>
          <div>
            <div class="font-extrabold text-white text-base leading-tight"><%= currentSettings.siteTitle %></div>
            <div class="text-[11px] text-brand-400 font-semibold tracking-wider uppercase">Yönetim Paneli</div>
          </div>
        <% } %>
      </a>
    </div>

    <!-- Menü Öğeleri -->
    <nav class="flex-1 px-4 py-6 space-y-1.5 overflow-y-auto">
      <a href="/admin" class="flex items-center space-x-3 px-3.5 py-3 rounded-xl text-sm font-semibold transition-all <%= typeof activeTab !== 'undefined' && activeTab === 'dashboard' ? 'bg-brand-500 text-dark-900 shadow-md' : 'text-slate-300 hover:bg-slate-800 hover:text-white' %>">
        <i class="fa-solid fa-chart-pie w-5 text-center text-base"></i>
        <span>Gösterge Paneli</span>
      </a>

      <a href="/admin/settings" class="flex items-center space-x-3 px-3.5 py-3 rounded-xl text-sm font-semibold transition-all <%= typeof activeTab !== 'undefined' && activeTab === 'settings' ? 'bg-brand-500 text-dark-900 shadow-md' : 'text-slate-300 hover:bg-slate-800 hover:text-white' %>">
        <i class="fa-solid fa-sliders w-5 text-center text-base"></i>
        <span>Genel Ayarlar & Logo</span>
      </a>

      <a href="/admin/content" class="flex items-center space-x-3 px-3.5 py-3 rounded-xl text-sm font-semibold transition-all <%= typeof activeTab !== 'undefined' && activeTab === 'content' ? 'bg-brand-500 text-dark-900 shadow-md' : 'text-slate-300 hover:bg-slate-800 hover:text-white' %>">
        <i class="fa-solid fa-pen-to-square w-5 text-center text-base"></i>
        <span>Yazılar & İçerik</span>
      </a>

      <a href="/admin/sliders" class="flex items-center space-x-3 px-3.5 py-3 rounded-xl text-sm font-semibold transition-all <%= typeof activeTab !== 'undefined' && activeTab === 'sliders' ? 'bg-brand-500 text-dark-900 shadow-md' : 'text-slate-300 hover:bg-slate-800 hover:text-white' %>">
        <i class="fa-solid fa-images w-5 text-center text-base"></i>
        <span>Slider / Banner</span>
      </a>

      <a href="/admin/projects" class="flex items-center space-x-3 px-3.5 py-3 rounded-xl text-sm font-semibold transition-all <%= typeof activeTab !== 'undefined' && activeTab === 'projects' ? 'bg-brand-500 text-dark-900 shadow-md' : 'text-slate-300 hover:bg-slate-800 hover:text-white' %>">
        <i class="fa-solid fa-camera-retro w-5 text-center text-base"></i>
        <span>Projeler & Fotoğraflar</span>
      </a>

      <a href="/admin/pages" class="flex items-center space-x-3 px-3.5 py-3 rounded-xl text-sm font-semibold transition-all <%= typeof activeTab !== 'undefined' && activeTab === 'pages' ? 'bg-brand-500 text-dark-900 shadow-md' : 'text-slate-300 hover:bg-slate-800 hover:text-white' %>">
        <i class="fa-solid fa-file-circle-plus w-5 text-center text-base"></i>
        <span>Sayfa Ekle / Çıkar</span>
      </a>

      <a href="/admin/services" class="flex items-center space-x-3 px-3.5 py-3 rounded-xl text-sm font-semibold transition-all <%= typeof activeTab !== 'undefined' && activeTab === 'services' ? 'bg-brand-500 text-dark-900 shadow-md' : 'text-slate-300 hover:bg-slate-800 hover:text-white' %>">
        <i class="fa-solid fa-trowel-bricks w-5 text-center text-base"></i>
        <span>Hizmetler</span>
      </a>

      <a href="/admin/messages" class="flex items-center justify-between px-3.5 py-3 rounded-xl text-sm font-semibold transition-all <%= typeof activeTab !== 'undefined' && activeTab === 'messages' ? 'bg-brand-500 text-dark-900 shadow-md' : 'text-slate-300 hover:bg-slate-800 hover:text-white' %>">
        <div class="flex items-center space-x-3">
          <i class="fa-solid fa-inbox w-5 text-center text-base"></i>
          <span>Gelen Mesajlar</span>
        </div>
        <% if (typeof unreadCount !== 'undefined' && unreadCount > 0) { %>
          <span class="px-2 py-0.5 rounded-full text-xs font-extrabold bg-rose-500 text-white"><%= unreadCount %></span>
        <% } %>
      </a>

      <div class="pt-4 border-t border-slate-800/80">
        <a href="/" target="_blank" class="flex items-center space-x-3 px-3.5 py-2.5 rounded-xl text-xs font-semibold text-slate-400 hover:text-brand-400 hover:bg-slate-800 transition-all">
          <i class="fa-solid fa-arrow-up-right-from-square w-5 text-center"></i>
          <span>Web Sitesini Görüntüle</span>
        </a>
      </div>
    </nav>

    <!-- Kullanıcı & Çıkış -->
    <div class="p-4 border-t border-slate-800 flex items-center justify-between bg-dark-850">
      <div class="flex items-center space-x-3">
        <div class="w-9 h-9 rounded-full bg-slate-800 text-brand-400 flex items-center justify-center font-bold text-sm">
          <i class="fa-solid fa-user-shield"></i>
        </div>
        <div class="text-xs">
          <div class="font-bold text-white"><%= adminUser ? adminUser.name : 'Yönetici' %></div>
          <div class="text-slate-500">Çevrimiçi</div>
        </div>
      </div>
      <a href="/admin/logout" class="p-2 text-slate-400 hover:text-rose-400 transition-colors" title="Güvenli Çıkış">
        <i class="fa-solid fa-right-from-bracket text-base"></i>
      </a>
    </div>
  </aside>

  <!-- Ana İçerik Alanı -->
  <main class="flex-1 flex flex-col min-w-0 bg-slate-100 overflow-x-hidden">
    <!-- Üst Header Bar -->
    <header class="bg-white border-b border-slate-200 px-6 py-4 flex items-center justify-between hidden md:flex">
      <div>
        <h1 class="text-xl font-bold text-dark-900"><%= typeof pageTitle !== 'undefined' ? pageTitle : 'Yönetim Paneli' %></h1>
        <p class="text-xs text-slate-500 mt-0.5">Sitenizin tüm dinamik içeriklerini, logolarını ve sayfalarını buradan yönetin.</p>
      </div>
      <div class="flex items-center space-x-4">
        <a href="/" target="_blank" class="inline-flex items-center space-x-2 text-xs font-bold text-slate-600 bg-slate-100 hover:bg-slate-200 px-3.5 py-2 rounded-xl border border-slate-200 transition-colors">
          <i class="fa-solid fa-eye text-brand-500"></i>
          <span>Siteyi Canlı Gör</span>
        </a>
        <a href="/admin/logout" class="text-xs font-bold text-rose-600 hover:text-rose-700 transition-colors flex items-center space-x-1.5">
          <i class="fa-solid fa-power-off"></i>
          <span>Çıkış</span>
        </a>
      </div>
    </header>

    <div class="p-4 sm:p-6 lg:p-8 flex-1">

