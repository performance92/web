<%- include('header') %>

<% if (typeof success !== 'undefined' && success) { %>
  <div class="mb-6 p-4 rounded-2xl bg-emerald-500 text-white text-sm font-semibold shadow-md flex items-center space-x-2">
    <i class="fa-solid fa-circle-check text-lg"></i>
    <span>Mesaj başarıyla silindi!</span>
  </div>
<% } %>

<div class="mb-8">
  <h2 class="text-xl font-bold text-dark-900">Gelen İletişim & Teklif Mesajları</h2>
  <p class="text-xs text-slate-500 mt-0.5">Web sitesindeki iletişim ve hızlı teklif formundan gönderilen ziyaretçi mesajları.</p>
</div>

<!-- Mesaj Listesi -->
<div class="space-y-4">
  <% if (messages && messages.length > 0) { %>
    <% messages.forEach(msg => { %>
      <div class="bg-white rounded-3xl p-6 border <%= !msg.read ? 'border-brand-500 shadow-md bg-amber-50/20' : 'border-slate-200 shadow-sm' %> transition-all">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-4 border-b border-slate-100">
          <div class="flex items-center space-x-3">
            <div class="w-10 h-10 rounded-xl <%= !msg.read ? 'bg-brand-500 text-dark-900 font-bold' : 'bg-slate-100 text-slate-600' %> flex items-center justify-center text-base shrink-0">
              <i class="fa-solid fa-user"></i>
            </div>
            <div>
              <div class="flex items-center space-x-2">
                <h4 class="font-bold text-dark-900 text-base"><%= msg.name %></h4>
                <% if (!msg.read) { %>
                  <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-rose-500 text-white">Yeni Okunmadı</span>
                <% } %>
              </div>
              <div class="text-xs text-slate-500 flex flex-wrap gap-4 mt-0.5">
                <span><i class="fa-solid fa-envelope text-[10px] text-brand-500 mr-1"></i><a href="mailto:<%= msg.email %>" class="hover:underline"><%= msg.email %></a></span>
                <span><i class="fa-solid fa-phone text-[10px] text-brand-500 mr-1"></i><a href="tel:<%= msg.phone %>" class="hover:underline"><%= msg.phone || '-' %></a></span>
                <span><i class="fa-regular fa-clock text-[10px] text-brand-500 mr-1"></i><%= new Date(msg.createdAt).toLocaleString('tr-TR') %></span>
              </div>
            </div>
          </div>

          <div class="flex items-center space-x-2">
            <% if (!msg.read) { %>
              <form action="/admin/messages/read/<%= msg.id %>" method="POST" class="inline">
                <button type="submit" class="px-3 py-1.5 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold text-xs transition-colors flex items-center space-x-1">
                  <i class="fa-solid fa-check text-[10px]"></i>
                  <span>Okundu Say</span>
                </button>
              </form>
            <% } %>
            <a href="mailto:<%= msg.email %>?subject=RE: <%= encodeURIComponent(msg.subject) %>" class="px-3 py-1.5 rounded-xl bg-brand-500 hover:bg-brand-600 text-dark-900 font-bold text-xs transition-colors flex items-center space-x-1">
              <i class="fa-solid fa-reply text-[10px]"></i>
              <span>Yanıtla</span>
            </a>
            <form action="/admin/messages/delete/<%= msg.id %>" method="POST" class="inline" onsubmit="return confirm('Bu mesajı silmek istediğinizden emin misiniz?');">
              <button type="submit" class="p-2 text-slate-400 hover:text-rose-600 transition-colors" title="Mesajı Sil">
                <i class="fa-solid fa-trash-can text-sm"></i>
              </button>
            </form>
          </div>
        </div>

        <div class="pt-4 space-y-2">
          <div class="text-xs font-bold text-brand-600 uppercase tracking-wider">
            Konu: <%= msg.subject %>
          </div>
          <div class="text-sm text-slate-700 leading-relaxed bg-slate-50 p-4 rounded-2xl border border-slate-100">
            <%= msg.message %>
          </div>
        </div>
      </div>
    <% }) %>
  <% } else { %>
    <div class="bg-white rounded-3xl p-16 border border-slate-200 text-center space-y-3">
      <div class="w-16 h-16 rounded-2xl bg-slate-100 text-slate-400 flex items-center justify-center text-2xl mx-auto">
        <i class="fa-regular fa-envelope-open"></i>
      </div>
      <h3 class="text-base font-bold text-slate-700">Henüz Gelen Mesaj Yok</h3>
      <p class="text-xs text-slate-400">Web sitesinden iletilen yeni mesajlar burada görüntülenecektir.</p>
    </div>
  <% } %>
</div>

<%- include('footer') %>

