<%- include('partials/head') %>
<%- include('partials/topbar') %>
<%- include('partials/navbar') %>

<!-- Dinamik Sayfa Başlığı & Banner -->
<section class="relative bg-dark-900 text-white py-24 overflow-hidden">
  <div class="absolute inset-0 z-0">
    <img src="<%= page.bannerImage %>" alt="<%= page.title %>" class="w-full h-full object-cover filter brightness-35">
    <div class="absolute inset-0 bg-gradient-to-t from-dark-900 via-dark-900/60 to-transparent"></div>
  </div>
  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-4">
    <div class="inline-flex items-center space-x-2 text-brand-400 font-extrabold text-xs tracking-wider uppercase">
      <a href="/" class="hover:text-white transition-colors">Anasayfa</a>
      <span class="text-slate-600">/</span>
      <span>Kurumsal</span>
      <span class="text-slate-600">/</span>
      <span><%= page.title %></span>
    </div>
    <h1 class="text-3xl sm:text-5xl font-extrabold text-white tracking-tight">
      <%= page.title %>
    </h1>
    <% if (page.metaDesc) { %>
      <p class="text-slate-300 text-base max-w-2xl mx-auto">
        <%= page.metaDesc %>
      </p>
    <% } %>
  </div>
</section>

<!-- Sayfa İçeriği -->
<section class="py-20 bg-white min-h-[600px]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">
      
      <!-- Sol: Dinamik Sayfa İçeriği (HTML formatlı zengin metin) -->
      <article class="lg:col-span-8 prose prose-lg prose-slate max-w-none">
        <div class="content-body text-slate-700 leading-relaxed space-y-6 text-base sm:text-lg">
          <%- page.content %>
        </div>
      </article>

      <!-- Sağ: Kurumsal Menü ve İletişim Kartı -->
      <aside class="lg:col-span-4 space-y-8">
        
        <!-- Diğer Kurumsal Sayfalar -->
        <% if (typeof otherPages !== 'undefined' && otherPages && otherPages.length > 0) { %>
          <div class="bg-slate-50 border border-slate-200 rounded-3xl p-6 space-y-4">
            <h4 class="font-bold text-dark-900 text-base flex items-center space-x-2 pb-3 border-b border-slate-200">
              <i class="fa-solid fa-sitemap text-brand-500"></i>
              <span>Kurumsal Sayfalar</span>
            </h4>
            <div class="space-y-2">
              <% otherPages.forEach(op => { %>
                <a href="/sayfa/<%= op.slug %>" class="flex items-center justify-between p-3 rounded-xl bg-white border border-slate-200 hover:border-brand-500 hover:text-brand-600 font-semibold text-sm transition-all group">
                  <span><%= op.title %></span>
                  <i class="fa-solid fa-chevron-right text-xs text-slate-400 group-hover:text-brand-500 transition-colors"></i>
                </a>
              <% }) %>
            </div>
          </div>
        <% } %>

        <!-- Danışma & Hızlı İletişim Kartı -->
        <div class="bg-dark-900 text-white p-8 rounded-3xl shadow-xl space-y-6">
          <div class="w-12 h-12 rounded-2xl bg-brand-500 text-dark-900 flex items-center justify-center text-xl">
            <i class="fa-solid fa-headset"></i>
          </div>
          <div>
            <h4 class="text-xl font-bold text-white">Detaylı Bilgiye mi İhtiyacınız Var?</h4>
            <p class="text-sm text-slate-300 mt-2 leading-relaxed">
              Tüm sorularınız ve proje talepleriniz için müşteri temsilcimizle hemen iletişime geçebilirsiniz.
            </p>
          </div>
          <div class="space-y-3 pt-2">
            <a href="tel:<%= settings.phone.replace(/[^0-9+]/g, '') %>" class="w-full bg-brand-500 hover:bg-brand-600 text-dark-900 font-bold py-3.5 px-4 rounded-xl flex items-center justify-center space-x-2 transition-all shadow-lg text-sm">
              <i class="fa-solid fa-phone"></i>
              <span><%= settings.phone %></span>
            </a>
            <a href="/iletisim" class="w-full bg-slate-800 hover:bg-slate-700 text-white font-semibold py-3.5 px-4 rounded-xl flex items-center justify-center space-x-2 border border-slate-700 transition-all text-sm">
              <i class="fa-solid fa-envelope"></i>
              <span>İletişim Formu</span>
            </a>
          </div>
        </div>

      </aside>

    </div>
  </div>
</section>

<%- include('partials/footer') %>

